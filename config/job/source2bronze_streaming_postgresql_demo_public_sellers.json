{
  "run_mode": {
    "name": "default"
  },
  "extract": {
    "sellers": {
      "reader": "JDBCReader",
      "url": "jdbc:postgresql://postgresdb.streaming.svc.cluster.local:5432/demo",
      "table": "public.sellers",
      "properties": {
        "user": "postgres",
        "password": "postgres",
        "driver": "org.postgresql.Driver"
      }
    }
  },
  "transform": {
    "transformer": "ConfigTransformer",
    "transformation": {
      "sellers": []
    }
  },
  "load": {
    "sellers": {
      "writer": "DeltaWriter",
      "mode": "overwrite",
      "table_name": "spark_catalog.bronze.olist_sellers",
      "path": "s3a://warehouse/bronze_superstore/olist_sellers",
      "partition_by": [],
      "first": true
    }
  }
}
